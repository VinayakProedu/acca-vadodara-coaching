rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth!=null;} function admin(){return signed()&&request.auth.token.admin==true;}
  function inBatch(id){return signed()&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.batchIds.hasAny([id]);}
  function enrolled(subject){return signed()&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledSubjects.hasAny([subject]);}
  match /users/{id}{allow read:if signed()&&(id==request.auth.uid||admin());allow write:if admin();}
  match /batches/{id}{allow read:if admin()||inBatch(id);allow write:if admin();}
  match /lectures/{id}{allow read:if admin()||enrolled(resource.data.subject);allow write:if admin();}
  match /tests/{id}{allow read:if admin()||enrolled(resource.data.subject);allow write:if admin();}
  match /attempts/{id}{allow read:if signed()&&(request.auth.uid==resource.data.userId||admin());allow create:if signed()&&(request.auth.uid==request.resource.data.userId||admin());allow update,delete:if admin();}
  match /leaderboard/{id}{allow read:if signed();allow write:if admin();}
  match /doubts/{id}{allow read:if admin()||inBatch(resource.data.batchId);allow create:if signed()&&inBatch(request.resource.data.batchId)&&request.resource.data.studentId==request.auth.uid;allow update,delete:if admin();match /replies/{reply}{allow read:if admin()||inBatch(get(/databases/$(database)/documents/doubts/$(id)).data.batchId);allow create:if signed()&&get(/databases/$(database)/documents/doubts/$(id)).data.studentId==request.auth.uid&&request.resource.data.authorId==request.auth.uid;}}
  match /{path=**}{allow read,write:if admin();}
 }
}
