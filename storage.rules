rules_version = '2';
service firebase.storage { match /b/{bucket}/o { function admin(){return request.auth!=null&&request.auth.token.admin==true;} function inBatch(id){return request.auth!=null&&firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.batchIds.hasAny([id]);} match /doubt-attachments/{batch}/{uid}/{doubt}/{file}{allow read:if admin()||inBatch(batch);allow create:if inBatch(batch)&&request.auth.uid==uid&&request.resource.size<10*1024*1024;} match /faculty-doubt-attachments/{batch}/{doubt}/{file}{allow read:if admin()||inBatch(batch);allow write:if admin()&&request.resource.size<10*1024*1024;} } }
